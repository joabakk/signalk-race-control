{
  "name": "signalk-race-control",
  "version": "0.12.11",
  "description": "SignalK plugin and webapp for tracking elapsed and handicap-corrected (Time-on-Time) race time, with a per-boat editable TCF and boat names pulled from AIS when available.",
  "main": "index.js",
  "author": "Joachim Bakke <github@heiamoss.com>",
  "repository": {
    "type": "git",
    "url": "https://github.com/joabakk/signalk-race-control.git"
  },
  "signalk": {
    "appIcon": "favicon.svg",
    "displayName": "Race Control",
    "screenshots": [
      "screenshots/results.png",
      "screenshots/course-chart.png",
      "screenshots/start-timer.png",
      "screenshots/mfd-leaderboard.png",
      "screenshots/mfd-countdown.png"
    ]
  },
  "keywords": [
    "signalk-node-server-plugin",
    "signalk-webapp",
    "signalk-category-race"
  ],
  "engines": {
    "node": ">=18"
  },
  "license": "MIT",
  "scripts": {
    "test": "node --test"
  },
  "overrides": {
    "uuid": "^11.1.1",
    "glob": {
      "brace-expansion": "^1.1.21"
    },
    "readdir-glob": {
      "brace-expansion": "^2.1.7"
    }
  },
  "devDependencies": {
    "exceljs": "^4.4.0"
  }
}
